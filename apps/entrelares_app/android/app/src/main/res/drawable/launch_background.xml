<?xml version="1.0" encoding="utf-8"?>
<!-- U-28 — the window the OS shows before the Flutter engine draws its first
     frame. It carries the product's emblem over the token surface, so the cold
     start reads as the app opening instead of as a white flash. `AppSplash`
     takes over from here with the animated calendar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
